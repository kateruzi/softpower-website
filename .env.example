# Образец окружения. Реальный .env лежит рядом на сервере и в git не входит.
# Скопируй файл в .env и подставь значения.

COMPOSE_PROJECT_NAME=softpower-website-staging   # или ...-prod
SHOP_ENV=staging                                 # staging | prod

POSTGRES_PASSWORD=                               # длинный случайный пароль

WEB_BIND=127.0.0.1                               # 0.0.0.0 только осознанно
WEB_PORT=8090
SITE_URL=http://127.0.0.1:8090                   # в prod: https://softpowerspace.com

TELEGRAM_BOT_TOKEN=                              # бот @softpowerspace_bot
ADMIN_CHAT_ID=                                   # кому падают заказы

# Пока ключей stripe нет, staging принимает оплату тестовым шлюзом.
DEV_FAKE_PAYMENTS=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Рубильник: SELLING=0 останавливает приём заказов, сайт продолжает работать.
SELLING=1
